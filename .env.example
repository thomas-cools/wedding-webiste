# Resend API Key - Get one at https://resend.com
# Required for sending RSVP confirmation emails
RESEND_API_KEY=re_xxxxxxxx

# From email address for confirmation emails
# Use 'onboarding@resend.dev' for testing, or your verified domain email for production
FROM_EMAIL=Wedding RSVP <onboarding@resend.dev>

# Google Maps / Places Autocomplete (client-side)
# This key is exposed to the browser (Vite only exposes variables prefixed with VITE_).
# Restrict it by HTTP referrer + API restrictions in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=

# Google Address Validation (server-side)
# Keep this key server-only (do NOT prefix with VITE_). Set it in Netlify env vars for production.
GOOGLE_MAPS_API_KEY=

# Gemini API key (server-side speech translation)
# Create at https://ai.google.dev/
GEMINI_API_KEY=

# Optional Gemini model override for speech translation
GEMINI_TRANSLATION_MODEL=gemini-2.5-flash

# Optional extracted speech text cap (characters)
SPEECH_DOC_MAX_EXTRACTED_CHARS=14000
